# Copy to .env and fill in. Never commit .env.

# --- Required ---
DB_DSN=mysql:host=localhost;dbname=miracle
DB_USERNAME=
DB_PASSWORD=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=
SUPPORT_EMAIL=
SENDER_EMAIL=
SENDER_NAME="Miracle Web Technologies"
# Long random strings, different for each side.
FRONTEND_COOKIE_VALIDATION_KEY=
BACKEND_COOKIE_VALIDATION_KEY=
# Base URL used in email links; deploy.sh refuses to run without it.
FRONTEND_BASE_URL=https://miraclewebtechnologies.com
# Encrypts 2FA secrets and stored cPanel passwords. Changing it makes those unreadable.
TWO_FACTOR_KEY=
# Development only: true = staff sign in without the authenticator code. Ignored unless YII_ENV=dev.
TWO_FACTOR_PAUSED=false

# --- Environment (production: prod, false, true) ---
YII_ENV=prod
YII_DEBUG=false
COOKIE_SECURE=true

# --- Optional ---
BACKEND_BASE_URL=https://admin.miraclewebtechnologies.com
# Fresh install only: the first admin's password.
ADMIN_INITIAL_PASSWORD=
ADMIN_BILLING_EMAIL=
DB_CHARSET=utf8mb4
SMTP_SCHEME=smtps
SMTP_PORT=465
MAIL_USE_FILE_TRANSPORT=false
GII_ALLOWED_IPS=
CRON_LOG_PATH=
# Contains {file}. Quote it, or the spaces break .env: BACKUP_OFFSITE_COMMAND="rclone copy {file} gdrive:miracle-backups"
BACKUP_OFFSITE_COMMAND=

# --- Billing ---
BILLING_GSTIN=
# GST rates in % (registered: 9, 9 and 18 for IT services). Empty = no GST charged.
BILLING_GST_CGST=
BILLING_GST_SGST=
BILLING_GST_IGST=
BILLING_LUT_ARN=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_NAME=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_IFSC=
BILLING_UPI_ID=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PayPal (clients abroad) ---
# PayPal Developer > Apps & Credentials > your REST app. PAYPAL_MODE=sandbox for test accounts.
# Switch gateways on for Indian or foreign clients in Site Settings > Payments.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- WhatsApp alerts ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
PROVIDER_INTEGRATED_NUMBER=
ADMIN_WHATSAPP_MOBILE=

# --- Copies sold to other businesses (dist.sh sets PORTAL_ONLY=true) ---
# true: only sign-in, the customer portal and admin billing; no website, blog or store, nothing indexed.
PORTAL_ONLY=false
# Invoice numbers start with this (1-5 capital letters or digits): ACM gives ACM2627-00001. Default MWT
# (INV on a copy).
INVOICE_PREFIX=
# The subscription's key (My Purchases where it was bought), checked daily by cron/licence-check.
LICENCE_KEY=
# LICENCE_SERVER=https://miraclewebtechnologies.com

# --- Tests only ---
# TEST_DB_DSN=
