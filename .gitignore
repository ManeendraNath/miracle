# =====================================================================
# 📁 1. ENVIRONMENT VARIABLES & LOCAL CONFIGURATIONS (CRUCIAL SECURITY)
# =====================================================================
.env
.env.local
.env.*
common/config/main-local.php
common/config/params-local.php
frontend/config/main-local.php
frontend/config/params-local.php
backend/config/main-local.php
backend/config/params-local.php
console/config/main-local.php
console/config/params-local.php

# =====================================================================
# 📁 2. PUBLIC ENTRY POINTS (ALLOW NATIVE COPIES, IGNORE COMPILED ASSETS)
# =====================================================================
# Allow index files so your local and server entry points track changes
!/frontend/web/index.php
!/backend/web/index.php
!/**/robots.txt

# Ignore dynamically compiled web assets generated by the framework
**/web/assets/*
!**/web/assets/.gitkeep

# =====================================================================
# 📁 3. FRAMEWORK RUNTIME DATA & LOG FILES
# =====================================================================
**/runtime/*
!**/runtime/.gitkeep

# =====================================================================
# 📁 4. EXTERNAL DEPENDENCIES & PACKAGE MANAGERS
# =====================================================================
/vendor/
/node_modules/
composer.phar
package-lock.json

# Keep composer.json and composer.lock tracked so teams use identical package definitions
!composer.json
!composer.lock
!package.json

# =====================================================================
# 📁 5. DEVELOPMENT ENVIRONMENTS, DOCKER & VAGRANT CONTAINER RUNTIMES
# =====================================================================
# Ignore local container database data pools, keep orchestration config intact
/docker/mysql_data/
!/docker/docker-compose.yml
!/docker/Dockerfile
/.vagrant/
/yii_test
/yii_test.bat

# =====================================================================
# 📁 6. IDE, SYSTEM CACHES & TESTING FRAMEWORKS
# =====================================================================
.idea/
.vscode/
nbproject/
.buildpath
.project
.settings/
Thumbs.db
.DS_Store
phpunit.phar
/phpunit.xml
