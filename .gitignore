# =====================================================================
# 1. ENVIRONMENT VARIABLES & LOCAL CONFIGURATION
# =====================================================================

.env
.env.local
.env.*

# Production/local parameter overrides are generated locally
common/config/params-local.php
frontend/config/params-local.php
backend/config/params-local.php
console/config/params-local.php

# main-local.php is intentionally tracked.
!common/config/main-local.php
!frontend/config/main-local.php
!backend/config/main-local.php
!console/config/main-local.php


# =====================================================================
# 2. PUBLIC ENTRY POINTS & GENERATED ASSETS
# =====================================================================

!/frontend/web/index.php
!/backend/web/index.php
!/**/robots.txt

**/web/error_log

**/web/assets/*
!**/web/assets/.gitkeep


# =====================================================================
# 3. FRAMEWORK RUNTIME DATA & LOGS
# =====================================================================

**/runtime/*
!**/runtime/.gitkeep


# =====================================================================
# 4. DEPENDENCIES
# =====================================================================

/vendor/
/node_modules/

composer.phar
package-lock.json

!composer.json
!composer.lock
!package.json


# =====================================================================
# 5. DOCKER / VAGRANT
# =====================================================================

/docker/mysql_data/
/mysql_data/

/.vagrant/

/yii_test
/yii_test.bat


# =====================================================================
# 6. IDE / OS FILES
# =====================================================================

.idea/
.vscode/
nbproject/

.buildpath
.project
.settings/

Thumbs.db
.DS_Store

phpunit.phar
/phpunit.xml